<% set_page_title(title_with_error_prefix(t(".title"), @feature_flags_input.errors.any?)) %>
<% content_for :back_link, govuk_back_link_to(@group, t("back_link.group", group_name: @group.name)) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render "shared/feature_flags_form",
          feature_flags_input: @feature_flags_input,
          url: feature_flags_group_path(@group),
          title: t(".title"),
          caption: @group.name,
          hint: t(".hint"),
          label_scope: "groups.feature_flags.flags" %>
  </div>
</div>

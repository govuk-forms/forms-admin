<% set_page_title(t(".title")) %>
<% content_for :back_link, govuk_back_link_to(welsh_translation_path(current_form)) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(model: welsh_translation_upload_input, url: welsh_translation_upload_path(current_form), method: 'POST') do |f| %>
      <% if welsh_translation_upload_input&.errors.any? %>
        <%= f.govuk_error_summary %>
      <% end %>

      <%= f.govuk_file_field :file,
        label: { tag: 'h1', size: 'l' },
        accept: Forms::WelshTranslationUploadInput::FILE_TYPES.join(", "),
        javascript: true
      %>

      <%= f.govuk_submit t(".submit") %>
    <% end %>
  </div>
</div>

